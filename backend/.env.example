# ─── Server ────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development   # development | production

# ─── MongoDB Atlas ─────────────────────────────────────────────
# Get this from: Atlas Dashboard → Connect → Drivers → Node.js
# IMPORTANT: URL-encode any special characters in your password.
#   e.g.  # → %23   * → %2A   @ → %40   : → %3A
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>"

# ─── JWT ───────────────────────────────────────────────────────
# Access token — short-lived (15 min). Used on every protected request.
# Must be at least 32 characters.
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars!!"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token — long-lived (7 days). Used ONLY at POST /api/auth/refresh.
# Must be DIFFERENT from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars!!"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── bcrypt ────────────────────────────────────────────────────
# 10–12 in production. Higher = slower hashing = more CPU.
BCRYPT_SALT_ROUNDS=12

# ─── CoinGecko (free tier) ─────────────────────────────────────
# Free tier: 50 req/min. Rate-limit handled by in-process 30s cache.
COINGECKO_API_URL="https://api.coingecko.com/api/v3"

# ─── Logging ───────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
