# ==============================================================================
# SOLIDUS — PRODUCTION ENVIRONMENT CONFIGURATION
# ⚠️ This platform enforces strict FAIL-FAST validation.
# If ANY of the required variables are missing, the server WILL NOT BOOT.
# ==============================================================================

# ─── Core App ──────────────────────────────────────────────────
# Core App
PORT=5050
NODE_ENV=production
FRONTEND_URL=https://your-frontend-url.vercel.app
CORS_ORIGIN=https://your-frontend-url.vercel.app

# MongoDB (Primary DB)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/solidus

# PostgreSQL (Analytics DB on Railway)
DATABASE_URL=postgresql://postgres:password@host.railway.app:5432/railway?pgbouncer=true

# Redis (BullMQ, WebSocket, Rate Limiting on Railway)
REDIS_URL=redis://default:password@host.railway.app:6379

# JWT & Auth
JWT_ACCESS_SECRET=your_32_char_secure_access_secret
JWT_REFRESH_SECRET=your_32_char_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-production-url.railway.app/api/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
   # development | production | test
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5050"
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"
LOG_LEVEL="info"

# ─── MongoDB (Primary Trading Ledger) ──────────────────────────
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>"

# ─── PostgreSQL (Analytics Layer) ──────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/solidus_analytics"

# ─── Redis (Queues, WebSockets, Rate Limiting) ─────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT & Auth ────────────────────────────────────────────────
# Must be at least 32 characters long.
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars!!"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars!!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# ─── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5050/api/auth/google/callback"

# ─── Cloudinary (Media Uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Stripe (Payments/Fiat) ────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Third-Party APIs (Optional) ───────────────────────────────
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
GNEWS_API_KEY="your-gnews-api-key"
