{
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 10000,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "cancel_open_orders_on_exit": false,
  "exchange": {
    "name": "binance",
    "key": "your_exchange_key",
    "secret": "your_exchange_secret",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 200
    },
    "pair_whitelist": [
      "BTC/USDT"
    ],
    "pair_blacklist": [
      "BNB/BTC",
      "USDC/USDT"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "webhook": {
    "enabled": true,
    "url": "http://host.docker.internal:4002/api/webhook",
    "webhookentry": {
      "type": "open",
      "botName": "Freqtrade NFI Cloud Engine",
      "botId": "5676cf32-e51e-4d6f-b79b-70972af629cc",
      "price": "{current_rate}"
    },
    "webhookexit": {
      "type": "close",
      "botName": "Freqtrade NFI Cloud Engine",
      "botId": "5676cf32-e51e-4d6f-b79b-70972af629cc",
      "pnl": "{profit_amount}",
      "price": "{current_rate}"
    }
  }
}